<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="norym.logisticsdeliverysystem.mapper.PostmanMapper">

    <select id="findById" resultType="Postman">
        SELECT id, username, password_hash, salt, name, phone, station_id, status, create_time
        FROM postman
        WHERE id = #{id}
    </select>

</mapper>
